[Unit]
Description=mycv.uz Telegram bot (long polling)
After=network.target postgresql.service

[Service]
User=mycv
Group=mycv
WorkingDirectory=/home/mycv/app
EnvironmentFile=/home/mycv/app/.env
ExecStart=/home/mycv/app/venv/bin/python manage.py runbot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
