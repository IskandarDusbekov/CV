# ─────────────────────────────────────────────────────────────────────────────
# mycv.uz — muhit sozlamalari. Nusxa oling:  cp .env.example .env
# Karta raqami, narxlar, limitlar, AI modeli va boshqalar .env da EMAS —
# ular admin panel → «Sayt sozlamalari» va «Tariflar» dan boshqariladi.
# ─────────────────────────────────────────────────────────────────────────────

# Productionda albatta False
DEBUG=False

# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit

# Domen(lar) — vergul bilan
DJANGO_ALLOWED_HOSTS=mycv.uz,www.mycv.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://mycv.uz,https://www.mycv.uz
CORS_ALLOWED_ORIGINS=https://mycv.uz

# Django admin manzili — taxmin qilib bo'lmaydigan qiling (kundalik ish uchun /panel/ bor)
ADMIN_URL=boshqaruv-o'zgartiring-7k2x

# Saytning to'liq manzili (bot yuboradigan havolalar uchun, oxirida / siz)
SITE_URL=https://mycv.uz

# HTTPS yoqilgach: SSL to'g'ri ishlashiga ishonch hosil qilib 31536000 qo'ying
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0

# Ma'lumotlar bazasi: postgres yoki sqlite
DB_ENGINE=postgres
DB_NAME=mycv
DB_USER=mycv
DB_PASSWORD=kuchli-parol
DB_HOST=127.0.0.1
DB_PORT=5432

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Telegram bot — @BotFather dan: /newbot
TELEGRAM_BOT_TOKEN=123456789:AA...
# Username admin paneldan ham o'zgartiriladi (@ belgisisiz)
TELEGRAM_BOT_USERNAME=mycv_uz_bot

DJANGO_LOG_LEVEL=INFO
